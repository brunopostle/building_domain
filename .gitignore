
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/
.venv/

# Monolithic snapshot — superseded by the per-table files in data/snapshot/.
# Kept ignorable so a local `bsos export -o data/bsos_snapshot.json` is never
# accidentally committed (it exceeds GitHub's 100 MB/file limit).
data/bsos_snapshot.json

# Beads / Dolt files (added by bd init)
.dolt/
*.db
*.db-shm
*.db-wal
.beads-credential-key
.bsos_config

# Local DB backups / scratch reports — never committed (bsos.db backups are
# 100MB+ and duplicate the git-tracked data/snapshot/ export anyway).
*.db.bak-*
compliance_report.txt
